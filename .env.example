# Copy this file to .env and fill in your credentials before running locally or building Docker.
# Notes are always stored inside the app's Notes/ folder (created automatically on first launch).

PORT = "3000"
HOST = "127.0.0.1"

# Single-user login credentials
AUTH_USERNAME = "admin"

# Set EITHER AUTH_PASSWORD_HASH (recommended) OR AUTH_PASSWORD.
# When you change your password from the Settings modal, AUTH_PASSWORD_HASH is written automatically.
# Generate a hash from CLI with: npm run hash-password
AUTH_PASSWORD = "changeme"
# AUTH_PASSWORD_HASH = "scrypt$...$..."

# Secret used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET = "replace-with-a-long-random-secret"

# Cookie Secure flag:
#   auto  -> Secure over HTTPS / Cloudflare Tunnel, works over HTTP locally (recommended)
#   true  -> Always require HTTPS
#   false -> Allow plain HTTP
COOKIE_SECURE = "auto"

# Default session duration in days (30 days when "Keep me signed in" is checked)
SESSION_TTL_DAYS = "7"
